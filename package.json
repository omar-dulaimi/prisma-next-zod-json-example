{
  "name": "prisma-orm-extension-zod-json-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reference app for prisma-orm-extension-zod-json: typed JSON columns validated by zod, on Prisma 8 + Postgres.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "emit": "prisma contract emit",
    "db:init": "prisma db init",
    "setup": "pnpm db:up && pnpm emit && pnpm db:init",
    "seed": "tsx src/seed.ts",
    "start": "tsx src/server.ts",
    "tour": "tsx src/tour.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@prisma/cli-engine": "0.2.0",
    "@prisma/orm-postgres": "8.0.0-rc.5",
    "dotenv": "^17.0.0",
    "hono": "^4.6.0",
    "prisma": "8.0.0-rc.7",
    "prisma-orm-extension-zod-json": "8.0.0-rc.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
